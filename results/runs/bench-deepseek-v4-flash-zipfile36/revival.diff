+"""Compatibility shim for the ``nntplib`` module.
+
+``nntplib`` was removed from the standard library in Python 3.13.  The
+vendored ``test.support`` still imports it and references
+``nntplib.NNTPTemporaryError``.  This module provides just enough of the
+old API for that code to keep working.
+"""
+
+
+class NNTPError(Exception):
+    """Base class for nntplib errors."""
+
+
+class NNTPTemporaryError(NNTPError):
+    """Exception raised for NNTP errors that are temporary."""
+
+
+class NNTPPermanentError(NNTPError):
+    """Exception raised for NNTP errors that are permanent."""
+
+
+class NNTPProtocolError(NNTPError):
+    """Exception raised when the NNTP protocol is violated."""
+
+
+class NNTPDataError(NNTPError):
+    """Exception raised when there is an error in the NNTP data."""
