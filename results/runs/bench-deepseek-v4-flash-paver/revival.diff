@@ -0,0 +1,10 @@
+"""Compatibility shim: distutils was removed in Python 3.12.
+
+This package re-exports the vendored distutils that ships with setuptools
+so that code written against the old ``distutils`` still works.
+"""
+import sys
+
+import setuptools._distutils as _distutils
+
+sys.modules[__name__] = _distutils
